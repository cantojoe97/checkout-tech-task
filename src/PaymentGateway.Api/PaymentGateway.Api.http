@baseUrl = https://localhost:7092
@expiryYear = 2030

# Bank simulator outcome is based on the card number's last digit
# (run `docker compose up -d` from the repo root first):
#   odd (1,3,5,7,9) -> authorized
#   even (2,4,6,8)  -> declined
#   0               -> bank returns 503

### Create payment (authorized - card ends in 1)
POST {{baseUrl}}/api/payments
Content-Type: application/json

{
  "cardNumber": 2222405343248871,
  "expiryMonth": 4,
  "expiryYear": {{expiryYear}},
  "currency": "GBP",
  "amount": 100,
  "cvv": "123"
}

> {%
    client.global.set("paymentId", response.body.id);
%}

### Get the payment created above
GET {{baseUrl}}/api/payments/{{paymentId}}
Accept: application/json

### Create payment (declined - card ends in 2)
POST {{baseUrl}}/api/payments
Content-Type: application/json

{
  "cardNumber": 2222405343248872,
  "expiryMonth": 4,
  "expiryYear": {{expiryYear}},
  "currency": "USD",
  "amount": 60000,
  "cvv": "456"
}

### Create payment (bank unavailable - card ends in 0)
POST {{baseUrl}}/api/payments
Content-Type: application/json

{
  "cardNumber": 2222405343248870,
  "expiryMonth": 4,
  "expiryYear": {{expiryYear}},
  "currency": "EUR",
  "amount": 250,
  "cvv": "789"
}

### Get a payment that doesn't exist
GET {{baseUrl}}/api/payments/00000000-0000-0000-0000-000000000001
Accept: application/json
